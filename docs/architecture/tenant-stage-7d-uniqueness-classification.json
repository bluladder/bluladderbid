  "classification_contract": {
    "intentionally platform-global": "The identifier or security token must be unique across the entire platform.",
    "organization-scoped composite key": "Add organization_id to the uniqueness key before a second organization is active.",
    "provider-scoped": "Scope uniqueness to the owning provider connector/account and organization where applicable.",
    "ambiguous and requiring decision": "Product or identity semantics must be decided before changing the key.",
    "safe for single-organization compatibility only": "Current global key preserves DFW but is not safe for a second active organization."
  },
